# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://chalk:chalk_dev_password@localhost:5432/chalk

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Clerk Auth ─────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Groq (LLM — Llama 3.3 70B, free tier) ─────────────
GROQ_API_KEY=gsk_...

# ─── Storage ────────────────────────────────────────────
# Use 'local' for dev (stores in ./uploads/), 's3' for production
STORAGE_PROVIDER=local
# S3 config (only needed when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=chalk-app

# ─── Tavily (Explore mode web search) ──────────────────
TAVILY_API_KEY=tvly-...

# ─── Server ─────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
